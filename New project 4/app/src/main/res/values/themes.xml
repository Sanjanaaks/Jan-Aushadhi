<resources>
    <style name="Theme.JanAushadhiFinder" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_green_dark</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/primary_green_dark</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="materialButtonStyle">@style/Widget.JAF.Button</item>
        <item name="materialCardViewStyle">@style/Widget.JAF.Card</item>
    </style>

    <style name="Widget.JAF.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.JAF.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>
